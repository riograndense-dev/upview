    "/api/v1/messages/send": {
      "post": {
        "summary": "Envia uma mensagem financeira de texto para cada cliente",
        "tags": ["messages"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": ["clientes"],
                "properties": {
                  "clientes": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["nome", "celular", "faturas"],
                      "properties": {
                        "nome": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 160,
                          "pattern": "\\S"
                        },
                        "celular": {
                          "type": "string",
                          "minLength": 10,
                          "maxLength": 30
                        },
                        "faturas": {
                          "type": "array",
                          "minItems": 1,
                          "maxItems": 100,
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["dataVencimento", "valor"],
                            "properties": {
                              "dataVencimento": {
                                "type": "string",
                                "format": "date"
                              },
                              "valor": {
                                "type": "number",
                                "exclusiveMinimum": 0,
                                "maximum": 999999999999.99,
                                "multipleOf": 0.01
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "referenceDate",
                    "requested",
                    "sent",
                    "failed",
                    "results"
                  ],
                  "properties": {
                    "referenceDate": { "type": "string", "format": "date" },
                    "requested": { "type": "integer", "minimum": 0 },
                    "sent": { "type": "integer", "minimum": 0 },
                    "failed": { "type": "integer", "minimum": 0 },
                    "results": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "index",
                          "nome",
                          "celular",
                          "tipoMensagem",
                          "categorias",
                          "status",
                          "providerMessageId",
                          "sentAt",
                          "errorCode"
                        ],
                        "properties": {
                          "index": { "type": "integer", "minimum": 0 },
                          "nome": { "type": "string" },
                          "celular": { "type": "string" },
                          "tipoMensagem": {
                            "type": "string",
                            "enum": [
                              "notary",
                              "overdue",
                              "today",
                              "upcoming",
                              "mixed"
                            ]
                          },
                          "categorias": {
                            "type": "array",
                            "items": {
                              "type": "string",
                              "enum": ["notary", "overdue", "today", "upcoming"]
                            }
                          },
                          "status": {
                            "type": "string",
                            "enum": ["sent", "failed"]
                          },
                          "providerMessageId": {
                            "type": "string",
                            "nullable": true
                          },
                          "sentAt": { "type": "string", "nullable": true },
                          "errorCode": { "type": "string", "nullable": true }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "207": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "referenceDate",
